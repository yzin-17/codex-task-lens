{
  "name": "codex-task-lens",
  "version": "0.1.0",
  "description": "Local, read-only task progress for Codex Desktop",
  "author": "yzin-17",
  "repository": { "type": "git", "url": "https://github.com/yzin-17/codex-task-lens.git" },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": { "node": ">=22.20.0" },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "build": "node scripts/build.mjs",
    "dev:test": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "dev:standalone": "pnpm build && node dist/node/host/standalone-runtime.js",
    "start": "node dist/node/cli/index.js",
    "doctor": "node dist/node/cli/index.js --doctor",
    "test:mac": "node dist/node/cli/mac-probe.js",
    "test:mac:acceptance": "node dist/node/cli/mac-acceptance.js",
    "build:agent": "pnpm build && node scripts/build-agent.mjs",
    "package:agent": "pnpm build:agent && node scripts/package-agent.mjs",
    "test:agent": "node scripts/smoke-agent-package.mjs"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.58.0",
    "@types/mdast": "4.0.4",
    "@types/node": "24.10.9",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.27.7",
    "eslint": "9.39.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
}
